# Database Configuration (MySQL / MariaDB via XAMPP)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/promptcommit_db

# Security — REQUIRED: Change this to a strong random secret!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Cloud Providers
DEFAULT_AI_PROVIDER=none
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Delivery (Resend - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=PromptCommit <onboarding@resend.dev>

# Frontend URL (for invitations and links)
FRONTEND_URL=http://localhost:5173
